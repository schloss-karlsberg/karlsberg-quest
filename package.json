{
  "name": "karlsberg-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Karlsberg Quest - a grim mystery-exploration browser game on the real LiDAR terrain of the Karlsberg (Homburg)",
  "scripts": {
    "dev": "vite --port 5280",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5281 --strictPort",
    "test": "vitest run",
    "e2e": "vite build && playwright test",
    "validate": "tsx scripts/validate-content.ts",
    "prepare-data": "tsx scripts/prepare-data.ts",
    "typecheck": "tsc --noEmit",
    "assets:pack": "tsx scripts/assets/pack-gltf.ts",
    "assets:tex": "tsx scripts/assets/pack-texture.ts",
    "assets:surface": "tsx scripts/assets/pack-surface.ts"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/three": "0.187.0",
    "jpeg-js": "0.4.4",
    "meshoptimizer": "0.22.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "proj4": "2.22.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.3.4"
}
