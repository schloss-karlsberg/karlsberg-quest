        { "do": "say", "id": "imhoff.t.station3", "speaker": "imhoff", "text": "So. Der Karlsbergweiher hier ist von der Schlossanlage geblieben.", "wait": true, "onResume": true },
        { "do": "say", "id": "imhoff.t.station3a", "speaker": "imhoff", "text": "Seht ihr die kleine Insel? Der Damm liegt am Westende.", "wait": true, "onResume": true },
        { "do": "say", "id": "imhoff.t.station3b", "speaker": "imhoff", "text": "Wann genau man den Weiher angelegt hat? Das ist offen.", "wait": true, "onResume": true },
