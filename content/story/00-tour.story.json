        { "do": "say", "id": "laub.t.intro", "speaker": "laub", "text": "Nicht fallen lassen. Ich bin schon einmal gefallen, das genügt.", "delay": 1.5 },
        { "do": "say", "id": "player.q.laub", "speaker": "player", "text": "…Hat der Kompass gerade geredet?" },
        { "do": "say", "id": "laub.t.intro.b", "speaker": "laub", "text": "Laub, Quirin, königlich bayerischer Geometer, abgeordnet zur Landesaufnahme im Rheinkreis. Seit November 1840 verwaltungstechnisch verschollen. Sie haben mich aus dem Wasser gezogen. Danke. Es war kalt, und es war lang." },
        { "do": "say", "id": "laub.t.quelle", "speaker": "laub", "text": "Hören Sie das? Nein, natürlich nicht. Das Wasser. Es erinnert sich an etwas." },
        { "do": "say", "id": "laub.t.trog", "speaker": "laub", "text": "Halten Sie die Hand hinein. Nein, das ist nicht hygienisch. Tun Sie es trotzdem." },
