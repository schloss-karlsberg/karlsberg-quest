      "do": [
        { "do": "sound", "sound": "howl", "x": 1222, "z": -1114, "caption": "[Stroh knistert]" },
        {
          "do": "say",
          "id": "laub.k3.x.strohmann",
          "speaker": "laub",
          "text": "Da. Hundert Wagen Stroh aus Lothringen, und das hier ist, was zurückschaut. Am Rücken, wo die Garben gebunden sind!",
          "delay": 1
        }
      ]
    },
    {
      "id": "strohmann-faellt",
