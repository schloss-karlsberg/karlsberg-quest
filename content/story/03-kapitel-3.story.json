        {
          "do": "say",
          "id": "laub.k3.x.strohmann_2",
          "speaker": "laub",
          "text": "Liegen geblieben. Jetzt zum Kommissär, E halten. Ich wünschte, ich könnte Ihnen sagen, dass es diesmal anders ausgeht.",
          "delay": 1.5
        }
      ]
    },
    {
