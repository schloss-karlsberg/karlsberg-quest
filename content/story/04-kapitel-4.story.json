              "do": "say",
              "id": "laub.k4.x.kuppe",
              "speaker": "laub",
              "text": "Schauen Sie nach Südwesten. Über die Stadt hinweg. Nein, weiter links. Der Berg mit den Mauerresten."
            }
          ]
        },
        {
          "id": "kuppe-stumm",
          "when": { "all": [{ "timer": 150 }, { "not": { "have": { "clue": "clue.k4.hohenburg" } } }] },
          "do": [
