      "when": { "all": [{ "era": "1796" }, { "meter": { "id": "vergessen", "gte": 0.04 } }] },
      "do": [
        {
          "do": "say",
          "id": "laub.k4.x.grau_0",
          "speaker": "laub",
          "text": "Sehen Sie das Grau am Rand? Das ist der Steinfraß. Bleiben Sie in Bewegung, finden Sie Spuren, dann weicht es. Durch den Nordflügel ist eine Bresche, da kommen Sie zu den Gräben."
        },
        {
          "do": "toast",
          "text": "Steinfraß: Wo das Grau steht, lösen sich die Steine auf. Es frisst vom Rand nach innen. Spuren [E] und Echos drängen es zurück. Ziel: durch die Bresche im Nordflügel zu den Gräben.",
          "ms": 9000,
          "delay": 4
        }
      ]
    },
    {
      "id": "grau-halb",
      "when": { "all": [{ "era": "1796" }, { "meter": { "id": "vergessen", "gte": 0.5 } }] },
      "do": [
        {
          "do": "say",
          "id": "laub.k4.x.grau_1",
          "speaker": "laub",
          "text": "Bleiben Sie nicht stehen. Erinnern Sie sich an etwas. An irgendwas. Notfalls an mich."
        }
      ]
    },
    {
      "id": "grau-voll",
      "when": { "all": [{ "era": "1796" }, { "meter": { "id": "vergessen", "gte": 0.8 } }] },
      "do": [
        {
          "do": "say",
          "id": "laub.k4.x.grau_2",
          "speaker": "laub",
          "text": "Wenn es zu grau wird: Q halten. Im Heute frisst er nicht. Langweilig, aber sicher."
        }
      ]
