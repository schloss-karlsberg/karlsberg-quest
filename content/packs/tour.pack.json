{
  "$schema": "../schema/pack.schema.json",
  "pack": "tour",
  "speakers": [
    { "id": "player", "name_de": "Du", "historical": false }
  ],
  "dialogue": [
    {
      "id": "imhoff.bark.wait.01",
      "speaker": "imhoff",
      "text_de": "Kommst du? Wir warten vorne.",
      "trigger": { "event": "walk:bark", "id": "imhoff.bark.wait" }
    },
    {
      "id": "imhoff.bark.wait.02",
      "speaker": "imhoff",
      "text_de": "Nicht verlaufen! Der Weg ist der mit den Leuten drauf.",
      "trigger": { "event": "walk:bark", "id": "imhoff.bark.wait" }
    },
    {
      "id": "imhoff.bark.wait.03",
      "speaker": "imhoff",
      "text_de": "Wer fotografiert, darf trödeln. Aber nicht ewig.",
      "trigger": { "event": "walk:bark", "id": "imhoff.bark.wait" }
    },
    {
      "id": "imhoff.bark.hier.01",
      "speaker": "imhoff",
      "text_de": "Hier drüben! Wir sind hier!",
      "trigger": { "event": "walk:bark", "id": "imhoff.bark.hier" }
    },
    {
      "id": "imhoff.bark.hier.02",
      "speaker": "imhoff",
      "text_de": "Hier drüben! Immer den Stimmen nach.",
      "trigger": { "event": "walk:bark", "id": "imhoff.bark.hier" }
    },
    {
      "id": "imhoff.t.station1",
      "speaker": "imhoff",
      "text_de": "Der Karlsberger Hof hier unten war das Baumagazin des Schlosses.",
      "trigger": { "event": "npc:talk", "npc": "imhoff", "chapter": "tour", "topic": "greet", "step": 1, "flag": "tour.station1.ready" },
      "once": true
    },
    {
      "id": "imhoff.t.station1a",
      "speaker": "imhoff",
      "text_de": "Da lagerte man Baumaterial. Im selben Gebäude gab es auch Wohnungen.",
      "trigger": { "event": "npc:talk", "npc": "imhoff", "chapter": "tour", "topic": "greet", "step": 2, "flag": "tour.station1.ready" },
      "once": true
    },
    {
      "id": "imhoff.t.station1b",
      "speaker": "imhoff",
      "text_de": "Und das Schloss da oben? Am 28. Juli 1793 ist es abgebrannt.",
      "trigger": { "event": "npc:talk", "npc": "imhoff", "chapter": "tour", "topic": "greet", "step": 3, "flag": "tour.station1.ready" },
      "once": true
    }
  ]
}
