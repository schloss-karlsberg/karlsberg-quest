{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-kirrberg.github.io/karlsberg-quest/schema/route.schema.json",
  "title": "Karlsberg Quest walk route (content/routes/<id>.json)",
  "description": "Editor support only. Generated by scripts/content-build/routes.mjs from scripts/content-build/routes/<id>.spec.json over public/data/paths.json; do not edit by hand. Consecutive points are 3–30 m apart, every stop lies within 3 m of the polyline and the stops are in route order (tests/routes.test.ts). Design: docs/design/tour/systems.md §3.",
  "type": "object",
  "required": ["id", "stops", "points"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "stops": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "x", "z"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "x": { "type": "number", "minimum": 150, "maximum": 2300 },
          "z": { "type": "number", "minimum": -2150, "maximum": 500 }
        }
      }
    },
    "points": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "number", "minimum": 150, "maximum": 2300 },
          { "type": "number", "minimum": -2150, "maximum": 500 }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
